<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="480.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutoria.controlador.AsignarTutoradoControlador">
   <children>
      <Pane prefHeight="60.0" prefWidth="720.0" style="-fx-background-color: #3b8d81;">
         <children>
            <Label layoutX="24.0" layoutY="14.0" text="Asignación de Tutorados" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <Label layoutX="24.0" layoutY="75.0" text="1. Seleccione un alumno de la lista:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      
      <TableView fx:id="tvTutorados" layoutX="24.0" layoutY="100.0" prefHeight="240.0" prefWidth="670.0">
        <columns>
          <TableColumn fx:id="colMatricula" prefWidth="120.0" text="Matrícula" />
          <TableColumn fx:id="colNombre" prefWidth="300.0" text="Nombre del Alumno" />
          <TableColumn fx:id="colCarrera" prefWidth="230.0" text="Carrera" />
        </columns>
      </TableView>

      <Label layoutX="24.0" layoutY="365.0" text="2. Seleccione el Tutor a asignar:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      
      <ComboBox fx:id="cbTutores" layoutX="250.0" layoutY="363.0" prefHeight="25.0" prefWidth="300.0" promptText="-- Seleccionar Profesor --" />

      <Button layoutX="594.0" layoutY="420.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #3b8d81;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      
      <Button layoutX="480.0" layoutY="420.0" mnemonicParsing="false" onAction="#cerrarVentana" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #cc3333;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>