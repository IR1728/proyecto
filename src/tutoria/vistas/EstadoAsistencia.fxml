<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="480.0" prefWidth="500.0" style="-fx-background-color: #339C8E;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutoria.controlador.EstadoAsistenciaControlador">
   <children>
      <Label layoutX="30.0" layoutY="25.0" text="Registrar Asistencia" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox layoutX="30.0" layoutY="80.0" prefWidth="440.0" spacing="15.0">
         <children>
            <HBox spacing="10.0">
               <children>
                  <Label text="Alumno:" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label fx:id="lbNombreAlumno" text="Nombre del Alumno Aquí" textFill="WHITE">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="Matrícula:" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label fx:id="lbMatricula" text="S000000" textFill="WHITE">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <Label text="Seleccione el estado de la sesión:" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <VBox spacing="12.0">
               <children>
                  <RadioButton fx:id="rbAsistio" mnemonicParsing="false" selected="true" text="Asistió" textFill="WHITE" toggleGroup="$grupoAsistencia">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <toggleGroup>
                        <ToggleGroup fx:id="grupoAsistencia" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="rbNoAsistio" mnemonicParsing="false" text="No Asistió" textFill="WHITE" toggleGroup="$grupoAsistencia">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </RadioButton>
                  <RadioButton fx:id="rbJustificado" mnemonicParsing="false" text="Justificado" textFill="WHITE" toggleGroup="$grupoAsistencia">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </RadioButton>
               </children>
               <VBox.margin>
                  <Insets left="20.0" />
               </VBox.margin>
            </VBox>
            <Label text="Observaciones (Opcional):" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
            <TextArea fx:id="txtObservaciones" prefHeight="80.0" prefWidth="440.0" promptText="Escribe aquí cualquier nota relevante..." wrapText="true" />
         </children>
      </VBox>
      <HBox layoutX="256.0" layoutY="420.0" spacing="15.0" />
      <Button layoutX="252.0" layoutY="449.0" mnemonicParsing="false" onAction="#cancelar" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #cc3333;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button layoutX="370.0" layoutY="449.0" mnemonicParsing="false" onAction="#guardar" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #2b2b2b;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
