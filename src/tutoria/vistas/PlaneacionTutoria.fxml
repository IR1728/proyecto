<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="600.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutoria.controlador.RegistrarPlaneacionControlador">
   <children>
      <Pane prefHeight="60.0" prefWidth="600.0" style="-fx-background-color: #3A128C;">
         <children>
            <Label layoutX="24.0" layoutY="14.0" text="Registrar Planeación de Tutoría" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <Label layoutX="40.0" layoutY="80.0" text="Periodo / Fecha de Tutoría:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbPeriodo" layoutX="40.0" layoutY="105.0" prefHeight="35.0" prefWidth="520.0" promptText="-- Seleccione el periodo --" />

      <Label layoutX="40.0" layoutY="160.0" text="Programa Educativo:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbPrograma" layoutX="40.0" layoutY="185.0" prefHeight="35.0" prefWidth="520.0" promptText="-- Seleccione el programa educativo --" />

      <Label layoutX="40.0" layoutY="240.0" text="Objetivos Generales:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextArea fx:id="taObjetivos" layoutX="40.0" layoutY="265.0" prefHeight="80.0" prefWidth="520.0" wrapText="true" />

      <Label layoutX="40.0" layoutY="360.0" text="Justificación (Opcional):">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextArea fx:id="taJustificacion" layoutX="40.0" layoutY="385.0" prefHeight="80.0" prefWidth="520.0" wrapText="true" />

      <Button fx:id="btnGuardar" layoutX="460.0" layoutY="490.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #27ae60;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      
      <Button fx:id="btnCancelar" layoutX="340.0" layoutY="490.0" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #e74c3c;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>