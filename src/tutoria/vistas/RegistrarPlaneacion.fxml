<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutoria.controlador.RegistrarPlaneacionControlador">
   <children>
      <Pane prefHeight="60.0" prefWidth="600.0" style="-fx-background-color: #3A128C;">
         <children>
            <Label layoutX="24.0" layoutY="14.0" text="Planeación de Tutoría" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <Label layoutX="40.0" layoutY="80.0" text="Seleccione Periodo y Sesión:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbFechas" layoutX="40.0" layoutY="105.0" prefHeight="30.0" prefWidth="520.0" promptText="-- Seleccione una fecha --" />

      <Label layoutX="40.0" layoutY="155.0" text="Objetivo de la Sesión:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextArea fx:id="taObjetivo" layoutX="40.0" layoutY="180.0" prefHeight="60.0" prefWidth="520.0" wrapText="true" />

      <Label layoutX="40.0" layoutY="255.0" text="Justificación / Instrucciones:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextArea fx:id="taInstrucciones" layoutX="40.0" layoutY="280.0" prefHeight="90.0" prefWidth="520.0" wrapText="true" />

      <Button fx:id="btnGuardar" layoutX="460.0" layoutY="390.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #27ae60;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>