<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="650.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutoria.controlador.RegistrarReporteTutoriaControlador">
   <children>
      <Pane prefHeight="60.0" prefWidth="650.0" style="-fx-background-color: #3A128C;">
         <children>
            <Label layoutX="24.0" layoutY="14.0" text="Reporte de Tutoría Académica" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <Label layoutX="40.0" layoutY="80.0" text="Seleccione el Periodo y Sesión a reportar:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbFecha" layoutX="40.0" layoutY="105.0" prefHeight="35.0" prefWidth="570.0" promptText="-- Cargando fechas disponibles --" />

      <Label layoutX="40.0" layoutY="160.0" text="Descripción General (Resumen de la sesión):">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextArea fx:id="taDescripcion" layoutX="40.0" layoutY="185.0" prefHeight="100.0" prefWidth="570.0" promptText="Describa brevemente cómo transcurrió la sesión..." wrapText="true" />

      <Label layoutX="40.0" layoutY="305.0" text="Comentarios y Observaciones para Coordinación:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextArea fx:id="taComentarios" layoutX="40.0" layoutY="330.0" prefHeight="150.0" prefWidth="570.0" promptText="Ingrese observaciones sobre el grupo, incidencias o necesidades detectadas..." wrapText="true" />

      <Button fx:id="btnGuardar" layoutX="510.0" layoutY="520.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #27ae60;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      
      <Button fx:id="btnCancelar" layoutX="390.0" layoutY="520.0" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #e74c3c;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>