<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutoria.controlador.RegistrarFechaTutoriaControlador">
   <children>
      <Pane prefHeight="60.0" prefWidth="600.0" style="-fx-background-color: #3A128C;">
         <children>
            <Label layoutX="24.0" layoutY="14.0" text="Configurar Fechas de Tutoría" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <Label layoutX="40.0" layoutY="90.0" text="Periodo Escolar:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbPeriodo" layoutX="40.0" layoutY="115.0" prefHeight="30.0" prefWidth="240.0" promptText="Seleccione el periodo" />

      <Label layoutX="320.0" layoutY="90.0" text="Número de Sesión:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbSesion" layoutX="320.0" layoutY="115.0" prefHeight="30.0" prefWidth="240.0" promptText="Sesión (1, 2, 3)" />

      <Separator layoutX="40.0" layoutY="170.0" prefWidth="520.0" />

      <Label layoutX="40.0" layoutY="190.0" text="Fecha de Inicio del Periodo:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <DatePicker fx:id="dpInicio" layoutX="40.0" layoutY="215.0" prefHeight="30.0" prefWidth="240.0" promptText="dd/mm/aaaa" />

      <Label layoutX="320.0" layoutY="190.0" text="Fecha de Cierre del Periodo:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <DatePicker fx:id="dpFin" layoutX="320.0" layoutY="215.0" prefHeight="30.0" prefWidth="240.0" promptText="dd/mm/aaaa" />

      <Button fx:id="btnGuardar" layoutX="460.0" layoutY="330.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #27ae60;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      
      <Button fx:id="btnCancelar" layoutX="340.0" layoutY="330.0" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #e74c3c;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>